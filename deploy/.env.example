# Configuracion de produccion. Copiar a deploy/.env y rellenar.
#
# Generar cada secreto por separado:
#   openssl rand -hex 32

# --- Dominio ---
# Debe resolver por DNS al VPS: Caddy pide el certificado con este nombre.
MCLOG_DOMAIN=mclog.tu-dominio.com

# --- Base de datos ---
POSTGRES_USER=mclog
POSTGRES_DB=mclog
POSTGRES_PASSWORD=CAMBIAR-contrasena-larga-y-aleatoria

# --- Secretos de la aplicacion ---
# Deben ser distintos entre si. El backend se niega a arrancar en produccion
# si conservan los valores de desarrollo.
JWT_ACCESS_SECRET=CAMBIAR-openssl-rand-hex-32
JWT_REFRESH_SECRET=CAMBIAR-otro-distinto-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# Clave heredada de ingesta. Se mantiene por compatibilidad con los emisores ya
# desplegados; lo recomendable es crear claves con scopes desde el dashboard
# (Administracion > API keys) y dejar esta con un valor aleatorio sin repartir.
API_KEY=CAMBIAR-openssl-rand-hex-32

# --- Administrador inicial (cuenta root) ---
# Se crea al primer arranque si no existe y no se puede borrar ni degradar.
# Cambiar la contrasena y activar la verificacion en dos pasos tras entrar.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=CAMBIAR-contrasena-fuerte

# --- Seguridad web ---
# El dominio exacto del dashboard, con https y sin barra final.
CORS_ORIGINS=https://mclog.tu-dominio.com
# Caddy termina el TLS y reenvia por HTTP: el backend debe confiar en las
# cabeceras del proxy para ver la IP real y el esquema original.
TRUST_PROXY=1
FORCE_HTTPS=1
COOKIE_SECURE=1
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
PUBLIC_DASHBOARD_URL=https://mclog.tu-dominio.com

# --- Servidor ---
PORT=3000
LOG_LEVEL=info
BODY_LIMIT=3mb

# --- Correo (alertas y "olvidé mi contraseña") ---
# Hace falta para el canal de email y para que los usuarios puedan restablecer
# su contraseña por correo (que usa además PUBLIC_DASHBOARD_URL para el enlace).
# Webhook y Telegram se configuran por completo desde el dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MCLog <no-reply@tu-dominio.com>

# --- Tiempo real ---
SSE_MAX_CONNECTIONS=50

# --- Acceso para IA ---
# Endpoint MCP en /mcp (requiere una API key con permiso read). 0 lo desactiva.
MCP_ENABLED=1

# --- Mantenimiento ---
# Meses que se conservan los logs (entre 3 y 60; fuera de ese rango se acota).
# La cuenta root puede cambiarlo en caliente desde Plataforma -> Configuracion.
RETENTION_MONTHS=3
SCHEDULER_ENABLED=1
BACKUP_RETENTION_DAYS=14

# --- Limites ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
INGEST_RATE_LIMIT_WINDOW_MS=60000
INGEST_RATE_LIMIT_MAX=2000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
MAX_BATCH_SIZE=500
MAX_EXPORT_ROWS=10000
