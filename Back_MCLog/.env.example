# --- Base de datos ---
# Dentro de docker compose el host es "db"; en desarrollo local es localhost:5434
DATABASE_URL=postgresql://postgres:postgres@db:5432/mclog?schema=public

# --- Servidor ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
BODY_LIMIT=3mb

# --- Seguridad ---
# API key para ingesta máquina-a-máquina (NetSuite, scripts) y /metrics. CAMBIAR en producción.
API_KEY=dev-key
CORS_ORIGINS=http://localhost:3001
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
FORCE_HTTPS=0
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
TRUST_PROXY=0

# --- Usuario admin inicial (se crea al arrancar si no existe) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- Rate limiting ---
# Consultas del dashboard
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
# Ingesta de logs (ventana corta, límite alto)
INGEST_RATE_LIMIT_WINDOW_MS=60000
INGEST_RATE_LIMIT_MAX=2000

# --- Límites de ingesta/exportación ---
MAX_BATCH_SIZE=500
MAX_EXPORT_ROWS=10000
