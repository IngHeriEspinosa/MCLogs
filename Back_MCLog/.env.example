# --- Base de datos ---
# Desarrollo local (el backend corre fuera de Docker y la DB publica el 5435).
# Dentro de docker compose el servicio api usa su propia URL interna (db:5432),
# definida en docker-compose.yml: no hace falta tocar esta linea para levantarlo.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/mclog?schema=public

# --- Servidor ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
BODY_LIMIT=3mb

# --- Seguridad ---
# API key para ingesta máquina-a-máquina (NetSuite, scripts) y /metrics. CAMBIAR en producción.
API_KEY=dev-key
CORS_ORIGINS=http://localhost:3001
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
FORCE_HTTPS=0
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
TRUST_PROXY=0

# --- Usuario admin inicial (se crea al arrancar si no existe) ---
# Este valor es publico: viaja en el repositorio. Con NODE_ENV=production el
# servicio se niega a arrancar si sigue puesto. Cambialo antes de desplegar.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- Rate limiting ---
# Consultas del dashboard
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
# Ingesta de logs (ventana corta, límite alto)
INGEST_RATE_LIMIT_WINDOW_MS=60000
INGEST_RATE_LIMIT_MAX=2000

# --- Límites de ingesta/exportación ---
MAX_BATCH_SIZE=500
MAX_EXPORT_ROWS=10000

# --- Mantenimiento automático ---
# Días de retención de logs. 0 = no purgar nunca (la tabla crecerá sin límite).
RETENTION_DAYS=30
# Con varias instancias detrás de un balanceador, dejarlo a 1 solo en una.
SCHEDULER_ENABLED=1

# --- Acceso para IA ---
# Endpoint MCP en /mcp, para que asistentes como Claude Code consulten los logs.
# Requiere una API key con scope "read". Ver docs/AI_INTEGRATION.md
MCP_ENABLED=1

# --- Tiempo real ---
# Conexiones simultáneas al stream de logs en vivo, por instancia.
SSE_MAX_CONNECTIONS=50

# --- Alertas por correo ---
# Sin SMTP_HOST, el canal de email avisa de que no está configurado; el resto
# de canales (webhook y Telegram) no necesitan nada de esto.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MCLog <no-reply@tu-dominio.com>

# --- Enlaces públicos ---
# URL del dashboard, usada para construir enlaces en notificaciones.
PUBLIC_DASHBOARD_URL=http://localhost:3001
