generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Log {
  id          Int         @id @default(autoincrement())
  timestamp   DateTime    @default(now())
  application String
  service     String?
  host        String?
  level       LogLevel
  environment Environment
  message     String
  traceId     String?     @db.VarChar(128)
  spanId      String?     @db.VarChar(128)
  metadata    Json?

  /// Clase de la excepcion ("TypeError", "SuiteScriptError").
  errorName   String? @db.VarChar(200)
  /// Codigo de error de la aplicacion o del proveedor ("ECONNRESET", "USER_ERROR").
  errorCode   String? @db.VarChar(100)
  errorStack  String?
  /// Huella de agrupacion: identifica ocurrencias del mismo fallo aunque el
  /// mensaje lleve ids, fechas o URLs distintos. Ver src/utils/fingerprint.ts.
  fingerprint String? @db.VarChar(64)

  @@index([timestamp])
  @@index([application])
  @@index([level])
  @@index([environment])
  @@index([traceId])
  @@index([application, timestamp])
  @@index([level, timestamp])
  @@index([fingerprint, timestamp])
  @@index([environment, level, timestamp])
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String
  role          String         @default("user")
  /// Cuenta de arranque (ADMIN_EMAIL). No se puede borrar ni degradar.
  isRoot        Boolean        @default(false)
  createdAt     DateTime       @default(now())

  /// Autenticacion en dos pasos (TOTP, RFC 6238). El secreto se guarda en
  /// cuanto se genera, pero no se exige hasta confirmarlo con un codigo.
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?  @db.VarChar(64)
  /// Ultimo paso de 30 s aceptado: impide reutilizar un codigo ya usado.
  twoFactorLastStep Int?
  /// sha256 hex de los codigos de recuperacion que quedan sin usar.
  recoveryCodes     String[] @default([])

  refreshTokens RefreshToken[]
  apiKeys       ApiKey[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([token])
}

/// Clave de API con permisos acotados. Solo se guarda el hash del secreto:
/// el valor en claro se muestra una unica vez, al crearla.
model ApiKey {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(120)
  /// Parte publica de la clave ("mclog_ab12cd34"), usada para localizarla sin exponer el secreto.
  prefix       String    @unique @db.VarChar(32)
  /// sha256 hex del secreto completo.
  keyHash      String    @unique @db.VarChar(64)
  /// Permisos: "ingest" (escribir logs), "read" (consultar), "metrics" (Prometheus).
  scopes       String[]
  /// Aplicaciones a las que queda limitada. Vacio = sin restriccion.
  applications String[]
  createdById  Int?
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  revokedAt    DateTime?

  @@index([revokedAt])
}

/// Destino al que se envía un aviso. La forma de `config` depende del tipo:
/// webhook `{ url, secret? }`, email `{ to: string[] }`, telegram `{ botToken, chatId }`.
model AlertChannel {
  id        Int              @id @default(autoincrement())
  name      String           @db.VarChar(120)
  type      AlertChannelType
  config    Json
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  rules     AlertRule[]
}

/// Condición que dispara un aviso.
model AlertRule {
  id      Int           @id @default(autoincrement())
  name    String        @db.VarChar(120)
  type    AlertRuleType @default(threshold)
  enabled Boolean       @default(true)

  /// Filtros. Nulo = cualquiera.
  application String?      @db.VarChar(120)
  service     String?      @db.VarChar(120)
  environment Environment?
  level       LogLevel     @default(error)

  /// Se dispara con `threshold` o más coincidencias en `windowMinutes`.
  threshold       Int @default(1)
  windowMinutes   Int @default(10)
  /// Silencio tras dispararse, para no repetir el mismo aviso cada minuto.
  cooldownMinutes Int @default(30)

  lastTriggeredAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  channels        AlertChannel[]
  events          AlertEvent[]

  @@index([enabled])
}

/// Registro de un disparo, con el resultado del envío a cada canal.
model AlertEvent {
  id           Int       @id @default(autoincrement())
  ruleId       Int
  rule         AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  triggeredAt  DateTime  @default(now())
  count        Int
  /// Muestra de logs que provocaron el disparo.
  sampleLogIds Int[]
  /// [{ channelId, channelName, ok, error? }]
  deliveries   Json

  @@index([ruleId, triggeredAt])
}

enum AlertChannelType {
  webhook
  email
  telegram
}

enum AlertRuleType {
  /// N o más coincidencias en la ventana.
  threshold
  /// Una huella de error vista por primera vez dentro de la ventana.
  new_error_group
}

enum LogLevel {
  debug
  info
  warn
  error
}

enum Environment {
  development
  staging
  production
}
