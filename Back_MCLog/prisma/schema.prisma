// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Log {
  id           Int         @id @default(autoincrement())
  /// Espacio de trabajo al que pertenece. Toda consulta va acotada por el.
  workspaceId  Int
  workspace    Workspace   @relation(fields: [workspaceId], references: [id])
  timestamp    DateTime    @default(now())
  application  String
  service      String?
  host         String?
  level        LogLevel
  environment  Environment
  message      String
  traceId      String?     @db.VarChar(128)
  spanId       String?     @db.VarChar(128)
  /// Tramo que contiene a este (el de la llamada que lo origino), para anidar
  /// los pasos de una traza.
  parentSpanId String?     @db.VarChar(128)
  /// Duracion del paso en milisegundos, si el emisor la mide.
  durationMs   Int?
  /// Version desplegada que emitio el log ("2.4.1", un commit...), si el emisor la manda.
  release      String?     @db.VarChar(120)
  metadata     Json?

  /// Clase de la excepcion ("TypeError", "SuiteScriptError").
  errorName   String? @db.VarChar(200)
  /// Codigo de error de la aplicacion o del proveedor ("ECONNRESET", "USER_ERROR").
  errorCode   String? @db.VarChar(100)
  errorStack  String?
  /// Huella de agrupacion: identifica ocurrencias del mismo fallo aunque el
  /// mensaje lleve ids, fechas o URLs distintos. Ver src/utils/fingerprint.ts.
  fingerprint String? @db.VarChar(64)

  /// La retencion purga por fecha en todos los espacios a la vez.
  @@index([timestamp])
  // El resto empieza por workspaceId: cada consulta del panel va acotada a un
  // espacio, y asi un espacio pequeno no paga por el volumen de los grandes.
  @@index([workspaceId, timestamp])
  @@index([workspaceId, application, timestamp])
  @@index([workspaceId, level, timestamp])
  @@index([workspaceId, fingerprint, timestamp])
  @@index([workspaceId, traceId])
  @@index([workspaceId, environment, level, timestamp])
}

/// Espacio de trabajo: la unidad de aislamiento. Logs, API keys y alertas
/// pertenecen a uno, y solo lo ven sus miembros.
model Workspace {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(120)
  createdAt DateTime  @default(now())
  /// Borrado logico: deja de verse al instante y el planificador purga sus
  /// logs por lotes despues, sin bloquear la peticion que lo borro.
  deletedAt DateTime?

  members       WorkspaceMember[]
  logs          Log[]
  apiKeys       ApiKey[]
  alertChannels AlertChannel[]
  alertRules    AlertRule[]
  snapshots     Snapshot[]
  errorGroups   ErrorGroup[]
  savedViews    SavedView[]
  digests       DigestSchedule[]

  @@index([deletedAt])
}

/// Ciclo de vida de un fallo (una huella) en un espacio: primera y ultima vez
/// de verdad, cuantas veces en total, su estado y sus regresiones. Se mantiene
/// en la ingesta (un upsert por lote) y sobrevive a la retencion: es una fila
/// por huella. Las cuentas de una ventana siguen saliendo de Log.
model ErrorGroup {
  id              Int              @id @default(autoincrement())
  workspaceId     Int
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fingerprint     String           @db.VarChar(64)
  /// Datos de la primera ocurrencia, para nombrar el fallo sin ir a Log.
  application     String
  service         String?
  errorName       String?          @db.VarChar(200)
  errorCode       String?          @db.VarChar(100)
  /// El nivel mas grave visto (una huella del emisor puede ir en cualquiera).
  level           LogLevel
  firstSeen       DateTime
  lastSeen        DateTime
  totalCount      Int              @default(0)
  status          ErrorGroupStatus @default(active)
  resolvedAt      DateTime?
  resolvedById    Int?
  resolvedBy      User?            @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  /// Ignorado hasta esta fecha; sin ella, para siempre.
  ignoredUntil    DateTime?
  /// Veces que volvio a aparecer despues de resolverse, y la ultima.
  regressionCount Int              @default(0)
  lastRegressedAt DateTime?
  firstRelease    String?          @db.VarChar(120)
  lastRelease     String?          @db.VarChar(120)
  note            String?          @db.VarChar(2000)

  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, status, lastSeen])
  @@index([workspaceId, firstSeen])
  @@index([workspaceId, lastRegressedAt])
}

enum ErrorGroupStatus {
  active
  resolved
  ignored
}

/// Vista guardada del espacio: una pantalla con sus filtros, para volver a
/// ella en un clic. La crea y la borra el dueno; la usan todos los miembros.
/// Las vistas personales viven en el navegador.
model SavedView {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(120)
  /// Pantalla: /logs, /records, /errors o /traces.
  path        String    @db.VarChar(64)
  /// Query string de la vista, sin el "?".
  query       String    @db.VarChar(2000)
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

/// Resumen programado (diario o semanal) que se envia por canales de alerta.
model DigestSchedule {
  id          Int             @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String          @db.VarChar(120)
  frequency   DigestFrequency @default(daily)
  /// Hora UTC del envio (0-23).
  hourUtc     Int             @default(8)
  /// Dia de la semana de los semanales (0 = domingo).
  weekday     Int             @default(1)
  environment Environment?
  enabled     Boolean         @default(true)
  lastSentAt  DateTime?
  createdAt   DateTime        @default(now())
  channels    AlertChannel[]

  @@index([enabled])
  @@index([workspaceId])
}

enum DigestFrequency {
  daily
  weekly
}

model WorkspaceMember {
  workspaceId Int
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(member)
  createdAt   DateTime      @default(now())

  @@id([workspaceId, userId])
  @@index([userId])
}

/// owner administra el espacio (miembros, API keys, alertas); member solo observa.
enum WorkspaceRole {
  owner
  member
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         String    @default("user")
  /// Cuenta de arranque (ADMIN_EMAIL). No se puede borrar ni degradar.
  isRoot       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  /// Null mientras la invitacion esta pendiente: la cuenta existe, pero no
  /// puede entrar hasta elegir su contrasena con el enlace recibido.
  activatedAt  DateTime?

  /// Autenticacion en dos pasos (TOTP, RFC 6238). El secreto se guarda en
  /// cuanto se genera, pero no se exige hasta confirmarlo con un codigo.
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?  @db.VarChar(64)
  /// Ultimo paso de 30 s aceptado: impide reutilizar un codigo ya usado.
  twoFactorLastStep Int?
  /// sha256 hex de los codigos de recuperacion que quedan sin usar.
  recoveryCodes     String[] @default([])

  refreshTokens       RefreshToken[]
  apiKeys             ApiKey[]
  passwordResetTokens PasswordResetToken[]
  memberships         WorkspaceMember[]
  settingsUpdated     AppSetting[]
  settingChanges      AppSettingChange[]
  snapshots           Snapshot[]
  resolvedErrorGroups ErrorGroup[]
  savedViews          SavedView[]
}

/// Configuracion de la aplicacion que la cuenta root cambia en caliente, sin
/// redesplegar. Una fila por clave; sin fila rige el valor predeterminado (el
/// de la variable de entorno). El catalogo y sus limites viven en
/// src/services/settingsService.ts.
model AppSetting {
  key         String   @id @db.VarChar(64)
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById Int?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Historial de la configuracion: una fila por cada valor que cambio, al
/// guardar o al restablecer. Solo se escribe; nunca se edita ni se purga.
model AppSettingChange {
  id             Int      @id @default(autoincrement())
  key            String   @db.VarChar(64)
  /// Valor vigente antes y despues del cambio (el predeterminado si no habia uno guardado).
  fromValue      Json
  toValue        Json
  /// true si se volvio al predeterminado borrando el valor guardado.
  reset          Boolean  @default(false)
  changedById    Int?
  changedBy      User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  /// Copia del correo: el historial sigue diciendo quien fue aunque se borre la cuenta.
  changedByEmail String   @db.VarChar(255)
  createdAt      DateTime @default(now())
}

/// Enlace de "olvide mi contrasena". Solo se guarda el hash: quien lea la base
/// de datos no puede usar un enlace pendiente. Se borra al usarse.
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 hex del token que viaja en el enlace.
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([token])
}

/// Clave de API con permisos acotados. Solo se guarda el hash del secreto:
/// el valor en claro se muestra una unica vez, al crearla.
model ApiKey {
  id            Int       @id @default(autoincrement())
  /// Espacio en el que escribe y que puede leer. Una clave nunca sale de el.
  workspaceId   Int
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  name          String    @db.VarChar(120)
  /// Parte publica de la clave ("mclog_ab12cd34"), usada para localizarla sin exponer el secreto.
  prefix        String    @unique @db.VarChar(32)
  /// sha256 hex del secreto completo.
  keyHash       String    @unique @db.VarChar(64)
  /// Permisos: "ingest" (escribir logs), "read" (consultar), "metrics" (Prometheus).
  scopes        String[]
  /// Aplicaciones a las que queda limitada. Vacio = sin restriccion.
  applications  String[]
  createdById   Int?
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  /// Ultima vez que se uso contra el servidor MCP (/mcp). Distingue a un
  /// asistente de IA de un script que consulta la API REST con la misma clave.
  lastMcpUsedAt DateTime?
  revokedAt     DateTime?

  @@index([revokedAt])
  @@index([workspaceId])
}

/// Copia congelada de una vista de logs para compartirla con un enlace. Guarda
/// los datos tal como estaban al crearla: no cambia con los logs nuevos ni
/// desaparece con la retencion.
model Snapshot {
  id           Int                @id @default(autoincrement())
  workspaceId  Int
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Identificador del enlace: 32 bytes aleatorios en base64url, imposible de adivinar.
  token        String             @unique @db.VarChar(64)
  title        String             @db.VarChar(160)
  /// Que vista se capturo: define la forma de `summary` y `logs`.
  kind         SnapshotKind       @default(logs)
  visibility   SnapshotVisibility @default(workspace)
  /// Si los datos se enmascararon al crearlo. Los publicos lo estan siempre.
  redacted     Boolean            @default(false)
  /// Filtros con los que se capturo, con el rango ya resuelto a fechas absolutas.
  filters      Json
  /// logs: metricas, serie por hora, repartos y fallos principales.
  /// errors: los grupos de fallo. trace: totales de la operacion.
  summary      Json
  /// logs: los que cumplen los filtros. errors: un ejemplo por grupo.
  /// trace: los de la traza. Siempre hasta `maxSnapshotRows`.
  logs         Json
  /// Cuantos logs cumplian los filtros, aunque se guardaran menos.
  totalMatched Int
  createdById  Int?
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  /// Null = no caduca.
  expiresAt    DateTime?
  viewCount    Int                @default(0)
  lastViewedAt DateTime?

  @@index([workspaceId, createdAt])
  @@index([expiresAt])
}

/// La pantalla de la que sale el snapshot.
enum SnapshotKind {
  logs
  errors
  trace
}

/// workspace: solo los miembros del espacio; public: cualquiera con el enlace.
enum SnapshotVisibility {
  workspace
  public
}

/// Destino al que se envía un aviso. La forma de `config` depende del tipo:
/// webhook `{ url, secret? }`, email `{ to: string[] }`, telegram `{ botToken, chatId }`.
model AlertChannel {
  id          Int              @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
  name        String           @db.VarChar(120)
  type        AlertChannelType
  config      Json
  enabled     Boolean          @default(true)
  createdAt   DateTime         @default(now())
  rules       AlertRule[]
  digests     DigestSchedule[]

  @@index([workspaceId])
}

/// Condición que dispara un aviso.
model AlertRule {
  id          Int           @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  name        String        @db.VarChar(120)
  type        AlertRuleType @default(threshold)
  enabled     Boolean       @default(true)

  /// Filtros. Nulo = cualquiera.
  application String?      @db.VarChar(120)
  service     String?      @db.VarChar(120)
  environment Environment?
  level       LogLevel     @default(error)

  /// Umbral, segun el tipo: coincidencias (threshold), grupos (new_error_group,
  /// regression), porcentaje de errores (error_rate) o multiplo de lo normal
  /// (spike). silence no lo usa.
  threshold       Int @default(1)
  windowMinutes   Int @default(10)
  /// Silencio tras dispararse, para no repetir el mismo aviso cada minuto.
  cooldownMinutes Int @default(30)
  /// Volumen minimo de la ventana para error_rate y spike: con tres logs, un
  /// porcentaje o un pico no significan nada.
  minVolume       Int @default(20)

  /// firing mientras la condicion se cumple; al despejarse se avisa de la
  /// recuperacion (en los tipos de condicion continua).
  state           AlertRuleState @default(ok)
  /// Silenciada hasta esta fecha: no se evalua ni avisa.
  mutedUntil      DateTime?
  lastTriggeredAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  channels        AlertChannel[]
  events          AlertEvent[]

  @@index([enabled])
  @@index([workspaceId])
}

/// Registro de un disparo, con el resultado del envío a cada canal.
model AlertEvent {
  id           Int            @id @default(autoincrement())
  ruleId       Int
  rule         AlertRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  triggeredAt  DateTime       @default(now())
  count        Int
  /// Muestra de logs que provocaron el disparo.
  sampleLogIds Int[]
  /// [{ channelId, channelName, ok, error? }]
  deliveries   Json
  /// trigger = se cumplio la condicion; resolve = se despejo.
  kind         AlertEventKind @default(trigger)

  @@index([ruleId, triggeredAt])
}

enum AlertChannelType {
  webhook
  email
  telegram
  /// Events API v2: abre y cierra incidentes; los resúmenes van como change events.
  pagerduty
}

enum AlertRuleType {
  /// N o más coincidencias en la ventana.
  threshold
  /// Una huella de error vista por primera vez dentro de la ventana.
  new_error_group
  /// Un fallo resuelto que vuelve a aparecer.
  regression
  /// El porcentaje de errores de la ventana llega al umbral.
  error_rate
  /// Ningun log en la ventana de algo que solia emitir (un script que dejo de correr).
  silence
  /// La ventana tiene `threshold` veces lo normal de la ultima semana.
  spike
}

enum AlertRuleState {
  ok
  firing
}

enum AlertEventKind {
  trigger
  resolve
}

enum LogLevel {
  debug
  info
  warn
  error
}

enum Environment {
  development
  staging
  production
}
